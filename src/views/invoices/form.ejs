<%- include('../layouts/main', { title: formTitle, body: compiledBody }) %>
<% var compiledBody = `
<%- include('../partials/breadcrumb', { page: formTitle }) %>
<h2><%= formTitle %></h2>
<form method="POST" action="<%= action %>">
  <div class="mb-3">
    <label class="form-label">Client Name</label>
    <input type="text" class="form-control" name="clientName" value="<%= invoice?.clientName || '' %>" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Date</label>
    <input type="date" class="form-control" name="date" value="<%= invoice?.date || '' %>" required>
  </div>
  <div id="items"></div>
  <button type="button" id="addItem" class="btn btn-secondary mb-3">+ Add Item</button>
  <div class="mb-3">
    <label class="form-label">Total</label>
    <input type="text" id="total" class="form-control" name="total" value="<%= invoice?.total || '' %>" readonly>
  </div>
  <button type="submit" class="btn btn-success">Save</button>
</form>
<script src="/js/invoice.js"></script>
` %>
