<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3">Invoices</h1>
  <a href="/invoices/create-form" class="btn btn-success">
    <i class="align-middle" data-feather="plus"></i> Add New Invoice
  </a>
</div>

<table class="table table-sm table-striped table-hover">
  <thead>
    <tr>
      <th>#</th>
      <th>Customer</th>
      <th>Total</th>
      <th>Date</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody>
    <% invoices.forEach((invoice, index) => { %>
      <tr>
        <td><%= invoice.invoiceNumber %></td>
        <td><%= invoice.customerName %></td>
        <td><%= invoice.grandTotal %></td>
        <td><%= invoice.createdAt.toLocaleDateString() %></td>
        <td class="text-nowrap">
          <a href="/invoices/<%= invoice._id %>" class="btn btn-sm btn-outline-primary" title="View">
            <i data-feather="eye"></i>
          </a>
          <a href="/invoices/<%= invoice._id %>/edit" class="btn btn-sm btn-outline-warning" title="Edit">
            <i data-feather="edit-2"></i>
          </a>
          <form action="/invoices/<%= invoice._id %>/delete" method="post" class="d-inline">
            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
              <i data-feather="trash-2"></i>
            </button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
